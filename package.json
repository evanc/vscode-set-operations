{
  "name": "set-ops",
  "displayName": "Set Ops",
  "description": "Intersection, union, difference, and more on the lines of your editor tabs.",
  "version": "0.1.0",
  "publisher": "evancoonrod",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evanc/vscode-set-operations.git"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b2649",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "set",
    "sets",
    "intersection",
    "union",
    "difference",
    "symmetric difference",
    "unique",
    "duplicates",
    "dedupe",
    "compare",
    "lines",
    "venn"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "setOps.intersection",
        "title": "Intersection",
        "category": "Set Ops"
      },
      {
        "command": "setOps.union",
        "title": "Union",
        "category": "Set Ops"
      },
      {
        "command": "setOps.difference",
        "title": "Difference",
        "category": "Set Ops"
      },
      {
        "command": "setOps.symmetricDifference",
        "title": "Symmetric Difference",
        "category": "Set Ops"
      },
      {
        "command": "setOps.unique",
        "title": "Unique",
        "category": "Set Ops"
      },
      {
        "command": "setOps.duplicates",
        "title": "Duplicates",
        "category": "Set Ops"
      }
    ],
    "submenus": [
      {
        "id": "setOps.submenu",
        "label": "Set Ops"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "submenu": "setOps.submenu",
          "group": "9_setOps",
          "when": "resourceSet"
        }
      ],
      "setOps.submenu": [
        {
          "command": "setOps.intersection",
          "group": "navigation@1"
        },
        {
          "command": "setOps.union",
          "group": "navigation@2"
        },
        {
          "command": "setOps.difference",
          "group": "navigation@3"
        },
        {
          "command": "setOps.symmetricDifference",
          "group": "navigation@4"
        },
        {
          "command": "setOps.unique",
          "group": "2_singleTab@1"
        },
        {
          "command": "setOps.duplicates",
          "group": "2_singleTab@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "test:integration": "npm run compile && node ./out/test/runIntegration.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
